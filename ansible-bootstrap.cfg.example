# Temporary configuration used only to install the collections required by
# local.yml before the private Automation Hub has been configured.
# Copy this file outside the repository and replace REPLACE_ME with the
# Red Hat Automation Hub token from console.redhat.com.

[galaxy]
server_list = automation_hub, galaxy

[galaxy_server.automation_hub]
url = https://console.redhat.com/api/automation-hub/content/published/
auth_url = https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
token = REPLACE_ME

[galaxy_server.galaxy]
url = https://galaxy.ansible.com/
